# Generate a real .env with: ./bin/org-tools env init
ORG_TOOLS_IMAGE=ghcr.io/iwonz/org-tools:latest
ORG_TOOLS_PORT=3000
ORG_TOOLS_PUBLIC_ORIGIN=http://localhost:3000
ORG_TOOLS_SETUP_TOKEN=GENERATE_WITH_BIN_ORG_TOOLS_ENV_INIT
POSTGRES_DB=org_tools
POSTGRES_USER=org_tools_owner
POSTGRES_PASSWORD=GENERATE_WITH_BIN_ORG_TOOLS_ENV_INIT
ORG_TOOLS_DB_USER=org_tools_app
ORG_TOOLS_DB_PASSWORD=GENERATE_WITH_BIN_ORG_TOOLS_ENV_INIT
ORG_TOOLS_DB_HOST=db
ORG_TOOLS_DB_PORT=5432
ORG_TOOLS_DB_SSLMODE=disable
ORG_TOOLS_POSTGRES_DATA_PATH=/absolute/path/outside/repository/postgres
ORG_TOOLS_BACKUP_PATH=/absolute/path/outside/repository/backups
