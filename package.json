{
  "name": "org-tools",
  "version": "1.0.0",
  "description": "A private organization editor with PostgreSQL persistence and role-based access control.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iwonz/org-tools.git"
  },
  "bugs": {
    "url": "https://github.com/iwonz/org-tools/issues"
  },
  "scripts": {
    "build": "pnpm --filter @org-tools/ui build",
    "build:ui": "pnpm --filter @org-tools/ui build",
    "dev": "./bin/org-tools dev",
    "dev-stop": "./bin/org-tools down",
    "dev:check": "ORG_TOOLS_TEST_UPSTREAM_ORIGIN=http://app:3000 node packages/screenshots/scripts/dev-check.mjs",
    "dev:ui": "./bin/org-tools dev",
    "format": "biome format --write .",
    "fixture:performance": "node scripts/generate-performance-fixture.mjs",
    "lint": "biome check .",
    "public:check": "node scripts/check-public-safety.mjs",
    "screenshots:generate": "pnpm --filter @org-tools/screenshots generate",
    "spec": "node scripts/run-openspec.mjs",
    "spec:validate": "node scripts/run-openspec.mjs validate --all --strict --no-interactive",
    "start": "./bin/org-tools up",
    "test": "pnpm test:unit",
    "test:browser": "pnpm --filter @org-tools/screenshots smoke",
    "test:unit": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @org-tools/ui typecheck && pnpm --filter @org-tools/screenshots typecheck"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@fission-ai/openspec": "1.5.0",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
