{
  "name": "@org-tools/screenshots",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "generate": "playwright test tests/screenshots.spec.ts --project=chromium",
    "generate:pages": "playwright test tests/pages-screenshots.spec.ts --config=playwright.pages.config.ts --project=chromium",
    "pages:smoke": "playwright test tests/pages.spec.ts --config=playwright.pages.config.ts --project=chromium",
    "smoke": "playwright test tests/smoke.spec.ts tests/localization.spec.ts tests/state.spec.ts --project=chromium",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@org-tools/types": "workspace:*",
    "@types/node": "^26.4.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2"
  }
}
