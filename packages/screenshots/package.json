{
  "name": "@org-tools/screenshots",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "generate": "node --env-file-if-exists=../../.env scripts/run-playwright.mjs test tests/screenshots.spec.ts --project=chromium",
    "smoke": "node --env-file-if-exists=../../.env scripts/run-playwright.mjs test tests/smoke.spec.ts tests/localization.spec.ts tests/auth-access.spec.ts --project=chromium",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@org-tools/types": "workspace:*",
    "@types/node": "^25.9.1",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3"
  }
}
